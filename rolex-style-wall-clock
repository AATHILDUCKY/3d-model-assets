// OpenJSCAD v2 — modern luxury wall clock.
// Units: millimetres. Default outside diameter: 300 mm.
//
// EXPORT:
// Select an individual part in "View / STL export", then export STL.
// "All printable parts" places every printable component at Z = 0.
// Assembled and exploded views are previews, not print layouts.
// Markers are separate glue-on components.
//
// BUILD:
// Buy a suitable quartz movement, preferably high torque, with matching
// hands, shaft hardware and battery. These cannot be printed here.
// Rear access opening: 72 x 72 mm. Dial thickness: 3 mm.
// Measure your movement before printing.
// Printed hands are templates with adjustable ROUND bores.
// D-shaped, press-fit and I-shaft fittings require a matching adapter
// or the movement manufacturer's compatible hands.
// Use lightweight hands and check torque, balance and clearances.
// Case and rear plate use four screw positions each.
// Pilot holes: 2.8 mm. Clearance holes: 3.6 mm.
// Choose plastic-compatible screws and confirm fit with a test print.
// Glue markers to the dial. Assemble using the preview as a guide.
// No glass, calendar mechanism or waterproof sealing is included.
// Parts must fit your printer's build area.
//
// Styling references:
// https://www.rolex.com/en-au/watchmaking/features/bezels/fluted-bezel
// https://newsroom.rolex.com/watches/oyster-collection/datejust
// Movement / hand compatibility:
// https://www.clockparts.com/
// JSCAD API:
// https://jscad.app/docs/

const jscad = require('@jscad/modeling');

const { cylinder, cuboid, polygon } = jscad.primitives;
const { union, subtract } = jscad.booleans;
const { translate, rotateZ } = jscad.transforms;
const { extrudeLinear } = jscad.extrusions;
const { measureBoundingBox } = jscad.measurements;
const { colorize } = jscad.colors;
const { vectorText } = jscad.text;

const TAU = Math.PI * 2;

function getParameterDefinitions() {
  return [
    {
      name: 'view',
      type: 'choice',
      caption: 'View / STL export',
      values: [
        'assembled', 'exploded', 'layout',
        'case', 'bezel', 'dial', 'back',
        'markers', 'hour', 'minute', 'second'
      ],
      captions: [
        'Assembled preview',
        'Exploded preview',
        'All printable parts',
        'Case',
        'Fluted bezel',
        'Dial',
        'Rear plate',
        'Hour markers — glue on',
        'Hour hand template',
        'Minute hand template',
        'Second hand template'
      ],
      initial: 'assembled'
    },
    {
      name: 'diameter',
      type: 'float',
      initial: 300,
      min: 180,
      max: 500,
      caption: 'Outside diameter (mm)'
    },
    {
      name: 'quality',
      type: 'choice',
      values: [96, 192, 288],
      captions: ['Draft', 'Standard', 'Fine'],
      initial: 192,
      caption: 'Circular resolution'
    },
    {
      name: 'shaftHole',
      type: 'float',
      initial: 10,
      min: 6,
      max: 16,
      caption: 'Movement shaft clearance diameter (mm)'
    },
    {
      name: 'hourHole',
      type: 'float',
      initial: 5,
      min: 1,
      max: 10,
      caption: 'Hour hand ROUND bore (mm)'
    },
    {
      name: 'minuteHole',
      type: 'float',
      initial: 3.2,
      min: 1,
      max: 8,
      caption: 'Minute hand ROUND bore (mm)'
    },
    {
      name: 'secondHole',
      type: 'float',
      initial: 1.2,
      min: 0.6,
      max: 4,
      caption: 'Second hand ROUND bore (mm)'
    },
    {
      name: 'clearance',
      type: 'float',
      initial: 0.35,
      min: 0.15,
      max: 0.8,
      caption: 'Radial fit clearance (mm)'
    },
    {
      name: 'brand',
      type: 'text',
      initial: 'MEKANTO',
      caption: 'Dial name — ASCII, max 12 characters'
    },
    {
      name: 'hourValue',
      type: 'int',
      initial: 10,
      min: 0,
      max: 23,
      caption: 'Preview hour'
    },
    {
      name: 'minuteValue',
      type: 'int',
      initial: 10,
      min: 0,
      max: 59,
      caption: 'Preview minute'
    },
    {
      name: 'secondValue',
      type: 'int',
      initial: 36,
      min: 0,
      max: 59,
      caption: 'Preview second'
    }
  ];
}

function main(input) {
  const defaults = {};
  getParameterDefinitions().forEach(d => {
    defaults[d.name] = d.initial;
  });

  const p = Object.assign(defaults, input || {});

  const R = Math.max(90, Math.min(250, Number(p.diameter) / 2));
  const q = Number(p.quality) || 192;
  const scale = R / 150;
  const gap = Math.max(0.15, Math.min(0.8, Number(p.clearance)));

  const innerRadius = R - 6;
  const seatRadius = R - 14;
  const dialRadius = innerRadius - gap;

  const gold = [0.82, 0.65, 0.31];
  const green = [0.018, 0.16, 0.105];
  const graphite = [0.09, 0.10, 0.115];
  const ivory = [0.84, 0.91, 0.84];

  const screwPositions = [45, 135, 225, 315].map(deg => {
    const angle = deg * Math.PI / 180;
    return [
      (R - 11) * Math.cos(angle),
      (R - 11) * Math.sin(angle)
    ];
  });

  function disk(radius, height, z = 0) {
    return cylinder({
      radius,
      height,
      center: [0, 0, z + height / 2],
      segments: q
    });
  }

  function ring(outer, inner, height, z = 0) {
    return subtract(
      disk(outer, height, z),
      disk(inner, height + 2, z - 1)
    );
  }

  function box(width, length, height, xy = [0, 0], z = 0) {
    return cuboid({
      size: [width, length, height],
      center: [xy[0], xy[1], z + height / 2]
    });
  }

  function hole(radius, height, xy, z = 0) {
    return translate(
      [xy[0], xy[1], 0],
      disk(radius, height, z)
    );
  }

  function radial(geometry, angle, radius) {
    return rotateZ(
      -angle,
      translate([0, radius, 0], geometry)
    );
  }

  function onPrintBed(geometry) {
    const bounds = measureBoundingBox(geometry);
    return translate([0, 0, -bounds[0][2]], geometry);
  }

  // Rounded stroke lettering built from closed, extruded polygons.
  function lettering(text, height, y, z, depth = 0.6) {
    const paths = vectorText({ height, input: text });
    const solids = [];
    const strokeWidth = 0.65;

    paths.forEach(path => {
      for (let i = 1; i < path.length; i++) {
        const a = path[i - 1];
        const b = path[i];

        const dx = b[0] - a[0];
        const dy = b[1] - a[1];
        const length = Math.hypot(dx, dy);

        if (length < 0.00001) continue;

        const nx = -dy / length * strokeWidth / 2;
        const ny = dx / length * strokeWidth / 2;

        solids.push(extrudeLinear(
          { height: depth },
          polygon({
            points: [
              [a[0] + nx, a[1] + ny],
              [a[0] - nx, a[1] - ny],
              [b[0] - nx, b[1] - ny],
              [b[0] + nx, b[1] + ny]
            ]
          })
        ));

        solids.push(translate(
          [a[0], a[1], 0],
          disk(strokeWidth / 2, depth)
        ));

        solids.push(translate(
          [b[0], b[1], 0],
          disk(strokeWidth / 2, depth)
        ));
      }
    });

    if (!solids.length) return null;

    const geometry = union(solids);
    const bounds = measureBoundingBox(geometry);

    return translate([
      -(bounds[0][0] + bounds[1][0]) / 2,
      y - (bounds[0][1] + bounds[1][1]) / 2,
      z
    ], geometry);
  }

  // CASE: open shell, front support ledge, internal screw bosses.
  const bosses = screwPositions.map(xy =>
    hole(4.6, 20, xy, 3)
  );

  let body = union(
    ring(R, innerRadius, 26),
    ring(innerRadius, seatRadius, 3, 23),
    bosses
  );

  body = subtract(
    body,
    screwPositions.flatMap(xy => [
      hole(1.4, 13, xy, -1),
      hole(1.4, 13, xy, 15)
    ])
  );

  // REAR PLATE: removable battery access and reinforced keyhole.
  const keyY = R * 0.62;

  let back = union(
    disk(innerRadius - gap, 3),
    box(22, 27, 3, [0, keyY], 3)
  );

  back = subtract(
    back,
    box(72, 72, 12, [0, 0], -1),
    hole(4.2, 10, [0, keyY - 5], -1),
    box(4.2, 12, 10, [0, keyY + 1], -1),
    screwPositions.map(xy => hole(1.8, 10, xy, -1))
  );

  // DIAL: engraved sunburst, raised minute track, embossed lettering.
  let dial = disk(dialRadius, 3);
  const sunburstCuts = [];

  for (let i = 0; i < 120; i++) {
    sunburstCuts.push(radial(
      box(0.35, R * 0.30, 0.28, [0, 0], 2.78),
      i * TAU / 120,
      R * 0.48
    ));
  }

  dial = subtract(
    dial,
    hole(Number(p.shaftHole) / 2, 7, [0, 0], -1),
    sunburstCuts,
    screwPositions.map(xy => hole(1.8, 7, xy, -1))
  );

  const minuteTicks = [];

  for (let i = 0; i < 60; i++) {
    const major = i % 5 === 0;

    minuteTicks.push(radial(
      box(
        major ? 1.3 : 0.65,
        (major ? 5 : 2.8) * scale,
        0.7,
        [0, 0],
        3
      ),
      i * TAU / 60,
      R * 0.824
    ));
  }

  const brandName = String(p.brand || 'MEKANTO')
    .replace(/[^A-Za-z0-9 .-]/g, '')
    .slice(0, 12)
    .toUpperCase();

  const brandText = lettering(
    brandName, 6 * scale, R * 0.34, 3
  );

  const quartzText = lettering(
    'QUARTZ', 3.2 * scale, -R * 0.34, 3
  );

  const emblem = extrudeLinear(
    { height: 0.8 },
    polygon({
      points: Array.from({ length: 8 }, (_, i) => {
        const angle = i * TAU / 8 + Math.PI / 2;
        const radius = (i % 2 ? 2 : 6) * scale;

        return [
          Math.cos(angle) * radius,
          Math.sin(angle) * radius + R * 0.46
        ];
      })
    })
  );

  dial = union(
    dial,
    minuteTicks,
    brandText ? [brandText] : [],
    quartzText ? [quartzText] : [],
    translate([0, 0, 3], emblem)
  );

  // BEZEL: 96 continuous flutes with a stepped inner reveal.
  const flutePoints = Array.from({ length: 384 }, (_, i) => {
    const angle = i * TAU / 384;
    const inset = i % 4 === 0 ? 0 : i % 4 === 2 ? 1.7 : 0.65;
    const radius = R - inset;

    return [
      radius * Math.cos(angle),
      radius * Math.sin(angle)
    ];
  });

  const flutedUpper = subtract(
    extrudeLinear(
      { height: 4.3 },
      polygon({ points: flutePoints })
    ),
    disk(R * 0.86, 6, -1)
  );

  let bezel = union(
    ring(R, R * 0.86, 2.2),
    translate([0, 0, 2.2], flutedUpper)
  );

  bezel = subtract(
    bezel,
    screwPositions.flatMap(xy => [
      hole(1.8, 12, xy, -4),
      hole(3.3, 2, xy, 5)
    ])
  );

  // MARKERS: double baton at 12; wider cardinal markers.
  const markers = [];

  for (let i = 0; i < 12; i++) {
    const angle = i * TAU / 12;
    const radius = R * 0.746;

    if (i === 0) {
      [-3 * scale, 3 * scale].forEach(x => {
        markers.push(radial(
          box(3.5 * scale, 14 * scale, 1.8, [x, 0]),
          angle,
          radius
        ));
      });
    } else {
      markers.push(radial(
        box(
          (i % 3 === 0 ? 6 : 4.5) * scale,
          (i % 3 === 0 ? 15 : 12) * scale,
          1.8
        ),
        angle,
        radius
      ));
    }
  }

  // HAND TEMPLATES: tapered profiles, reinforced hubs, adjustable bores.
  function makeHand(length, width, bore, thickness, tail) {
    const outline = polygon({
      points: [
        [-width * 0.36, -tail],
        [width * 0.36, -tail],
        [width / 2, length * 0.58],
        [width * 0.23, length * 0.88],
        [0, length],
        [-width * 0.23, length * 0.88],
        [-width / 2, length * 0.58]
      ]
    });

    return subtract(
      union(
        extrudeLinear({ height: thickness }, outline),
        disk(Math.max(5, bore / 2 + 2), thickness)
      ),
      disk(bore / 2, thickness + 2, -1)
    );
  }

  const hour = makeHand(
    R * 0.52, 8 * scale,
    Number(p.hourHole), 1.2, 12 * scale
  );

  const minute = makeHand(
    R * 0.72, 5.5 * scale,
    Number(p.minuteHole), 1.0, 15 * scale
  );

  const second = subtract(
    union(
      box(1.3, R * 0.96, 0.8, [0, R * 0.30]),
      hole(5.5 * scale, 0.8, [0, -R * 0.13]),
      disk(Math.max(3, Number(p.secondHole) / 2 + 1.2), 0.8)
    ),
    disk(Number(p.secondHole) / 2, 3, -1)
  );

  const parts = {
    case: body,
    bezel,
    dial,
    back,
    markers,
    hour,
    minute,
    second
  };

  const palette = {
    case: graphite,
    bezel: gold,
    dial: green,
    back: graphite,
    markers: gold,
    hour: gold,
    minute: gold,
    second: ivory
  };

  // Individual export: selected part or marker set, grounded at Z = 0.
  if (parts[p.view]) {
    const selected = Array.isArray(parts[p.view])
      ? parts[p.view]
      : [parts[p.view]];

    return selected.map(geometry =>
      colorize(palette[p.view], onPrintBed(geometry))
    );
  }

  // Separated layout: all parts visible, no overlaps between groups.
  if (p.view === 'layout') {
    const pitch = 2 * R + 25;
    const names = [
      'case', 'bezel', 'dial', 'back',
      'markers', 'hour', 'minute', 'second'
    ];

    return names.flatMap((name, index) => {
      const geometries = Array.isArray(parts[name])
        ? parts[name]
        : [parts[name]];

      return geometries.map(geometry =>
        colorize(
          palette[name],
          translate(
            [
              (index % 3) * pitch,
              -Math.floor(index / 3) * pitch,
              0
            ],
            onPrintBed(geometry)
          )
        )
      );
    });
  }

  // Assembly coordinates: rear at Z = 0, dial front at Z = 29.
  const exploded = p.view === 'exploded';
  const lift = exploded ? 22 : 0;

  const output = [
    colorize(graphite, body),
    colorize(
      graphite,
      translate([0, 0, exploded ? -22 : 0], back)
    ),
    colorize(
      green,
      translate([0, 0, 26 + lift], dial)
    ),
    colorize(
      gold,
      translate([0, 0, 29 + lift * 3], bezel)
    )
  ];

  markers.forEach(geometry => {
    output.push(colorize(
      gold,
      translate([0, 0, 29 + lift * 2], geometry)
    ));
  });

  const hours = Number(p.hourValue);
  const minutes = Number(p.minuteValue);
  const seconds = Number(p.secondValue);

  output.push(colorize(
    gold,
    translate(
      [0, 0, 31.6 + lift * 4],
      rotateZ(
        -(hours % 12 + minutes / 60) * TAU / 12,
        hour
      )
    )
  ));

  output.push(colorize(
    gold,
    translate(
      [0, 0, 34 + lift * 5],
      rotateZ(
        -(minutes + seconds / 60) * TAU / 60,
        minute
      )
    )
  ));

  output.push(colorize(
    ivory,
    translate(
      [0, 0, 36.4 + lift * 6],
      rotateZ(-seconds * TAU / 60, second)
    )
  ));

  return output;
}

module.exports = { main, getParameterDefinitions };
